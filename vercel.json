{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/api/proxy?path=auth/:path*"
    },
    {
      "source": "/rest/:path*",
      "destination": "/api/proxy?path=rest/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "/api/proxy?path=storage/:path*"
    },
    {
      "source": "/realtime/:path*",
      "destination": "/api/proxy?path=realtime/:path*"
    }
  ]
}