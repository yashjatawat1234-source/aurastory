{
  "rewrites": [
    {
      "source": "/api/proxy",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/rest/:path*",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/storage/:path*",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/((?!api/|assets/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}