{
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/proxy",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/rest/:path*",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/storage/:path*",
      "destination": "/api/proxy.js"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}